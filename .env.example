# Скопируй в nutrition_bot/.env и подставь свои значения
BOT_TOKEN=123456:AA...

# Путь к SQLite (по умолчанию nutrition_bot/data/nutrition.sqlite3)
# NUTRITION_DB_PATH=

# Ollama:    http://localhost:11434/v1
# LM Studio: http://localhost:1234/v1
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b-instruct
LLM_TIMEOUT_SECONDS=60
LLM_ENABLED=true

WEB_HOST=127.0.0.1
WEB_PORT=8000
# Secure-флаг для куки сессии: включать только если перед дашбордом стоит HTTPS
# WEB_HTTPS=false

# Системный DNS-резолвер вместо aiodns. Отключать только если понимаешь зачем:
# на части сетей aiodns падает с "Could not contact DNS servers".
USE_THREADED_RESOLVER=true
